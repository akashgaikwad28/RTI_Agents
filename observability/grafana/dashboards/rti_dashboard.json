{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "title": "RTI Agent Dashboard",
  "uid": "rti-agent-prod",
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "type": "stat",
      "title": "Active Requests",
      "targets": [
        {
          "expr": "rti_active_requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "type": "stat",
      "title": "Total Cost (USD)",
      "targets": [
        {
          "expr": "sum(rti_estimated_cost_usd_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "type": "timeseries",
      "title": "Requests per Minute",
      "targets": [
        {
          "expr": "rate(rti_requests_total[1m]) * 60",
          "legendFormat": "{{intent}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "type": "timeseries",
      "title": "RAG Retrieval Latency (Seconds)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_retrieval_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "type": "timeseries",
      "title": "LLM Token Usage Rate",
      "targets": [
        {
          "expr": "rate(rti_token_usage_total[1m])",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "type": "timeseries",
      "title": "Security Events",
      "targets": [
        {
          "expr": "rate(rti_security_events_total[5m])",
          "legendFormat": "{{classification}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 14 },
      "type": "stat",
      "title": "Documents Ingested",
      "targets": [
        {
          "expr": "sum(documents_ingested_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 14 },
      "type": "stat",
      "title": "Scrape Failures",
      "targets": [
        {
          "expr": "sum(scrape_failures_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "type": "timeseries",
      "title": "MongoDB & FAISS Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rti_mongodb_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "MongoDB p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(faiss_search_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "FAISS p95",
          "refId": "B"
        }
      ]
    }
  ]
}
